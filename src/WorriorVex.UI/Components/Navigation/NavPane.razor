@inject Translator T
@using WorriorVex.Application.Tags

<nav class="wn-nav" aria-label="@T["Navigation"]" @ref="Root">
    <ul class="wn-nav-list">
        @if (Inbox is not null)
        {
            var inbox = new NavSelection.Notebook(Inbox.Id);
            var inboxHasNotes = _notes.Contains((Inbox.Id, null));
            var inboxExpanded = !_collapsedNotebooks.Contains(Inbox.Id);
            <li>
                <div class="wn-navrow">
                    @if (inboxHasNotes)
                    {
                        <button type="button" class="wn-twisty" data-twisty aria-expanded="@(inboxExpanded ? "true" : "false")" aria-label="@(inboxExpanded ? T["Collapse"] : T["Expand"]) @T["Inbox"]" tabindex="-1"
                                @onclick="() => Toggle(Inbox.Id)">@(inboxExpanded ? "−" : "+")</button>
                    }
                    else
                    {
                        <span class="wn-twisty" aria-hidden="true"></span>
                    }
                    <button type="button" class="wn-navitem @SelectedClass(inbox) @DropClass(Inbox.Id)" aria-current="@Current(inbox)"
                            data-tree-item data-level="0" data-expanded="@(inboxHasNotes ? (inboxExpanded ? "true" : "false") : null)"
                            @onclick="() => OnSelect.InvokeAsync(inbox)"
                            @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((inbox, e))"
                            @ondragenter="() => _dropTarget = Inbox.Id" @ondragover:preventDefault @ondrop:preventDefault @ondrop="() => DropAsync(inbox)">@T["Inbox"]</button>
                </div>
                @if (inboxHasNotes && inboxExpanded)
                {
                    <FolderTree NotebookId="Inbox.Id" ParentId="null" Children="_children" Notes="_notes" Expanded="_expandedFolders" DropTarget="_dropTarget"
                                Selection="Selection" CurrentNoteId="CurrentNoteId" OnSelect="OnSelect" OnToggle="Toggle" OnContextMenu="OnContextMenu"
                                OnDragStart="OnDragStart" OnDragEnd="OnDragEnd" OnDragEnter="id => _dropTarget = id" OnDrop="DropAsync" OnAddFolder="OnAddFolder"
                                OnRenameFolder="OnRenameFolder" OnDeleteFolder="OnDeleteFolder" OnAddUnderNote="OnAddUnderNote"
                                OnOpenNote="OnOpenNote" OnNoteContextMenu="OnNoteContextMenu" OnNoteDragStart="OnNoteDragStart"
                                OnRenameNote="OnRenameNote" OnDeleteNote="OnDeleteNote" SharedOrder="SharedOrder" OnDropOnNote="OnDropOnNote" OnMoveBy="OnMoveBy" Level="1" />
                }
            </li>
        }
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.AllNotes())" aria-current="@Current(new NavSelection.AllNotes())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.AllNotes())">@T["All Notes"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Favorites())" aria-current="@Current(new NavSelection.Favorites())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Favorites())">@T["Favorites"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Recent())" aria-current="@Current(new NavSelection.Recent())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Recent())">@T["Recent"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.LooseEnds())" aria-current="@Current(new NavSelection.LooseEnds())"
                    title="@T["Notes with no tag and no link to or from another note"]" @onclick="() => OnSelect.InvokeAsync(new NavSelection.LooseEnds())">@T["Loose ends"]</button>
        </li>
    </ul>

    @if (SavedSearches.Count > 0)
    {
        <div class="wn-nav-section">
            <h2 id="wn-saved-heading">@T["Saved searches"]</h2>
        </div>
        <ul class="wn-nav-list" aria-labelledby="wn-saved-heading">
            @for (var i = 0; i < SavedSearches.Count; i++)
            {
                var index = i;
                var saved = SavedSearches[i];
                var selection = new NavSelection.SavedSearch(index);
                <li @key="saved">
                    <button type="button" class="wn-navitem wn-navitem-tag @SelectedClass(selection)" aria-current="@Current(selection)" title="@saved.Query"
                            @onclick="() => OnSelect.InvokeAsync(selection)"
                            @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((selection, e))">
                        <span class="wn-navitem-label">@saved.Name</span>
                    </button>
                </li>
            }
        </ul>
    }

    <div class="wn-nav-section">
        <h2 id="wn-notebooks-heading">@T["Notebooks"]</h2>
        <button type="button" class="wn-iconbutton" title="@T["New notebook"]" aria-label="@T["New notebook"]" @onclick="OnNewNotebook">+</button>
    </div>

    @if (UserNotebooks.Count == 0)
    {
        <p class="wn-nav-hint">@T["No notebooks yet."]</p>
    }
    else
    {
        <ul class="wn-nav-list" aria-labelledby="wn-notebooks-heading">
            @foreach (var notebook in UserNotebooks)
            {
                var selection = new NavSelection.Notebook(notebook.Id);
                var hasChildren = _children.Contains((notebook.Id, null)) || _notes.Contains((notebook.Id, null));
                var expanded = !_collapsedNotebooks.Contains(notebook.Id);
                <li @key="notebook.Id">
                    <div class="wn-navrow">
                        @if (hasChildren)
                        {
                            <button type="button" class="wn-twisty" data-twisty aria-expanded="@(expanded ? "true" : "false")"
                                    aria-label="@(expanded ? T["Collapse"] : T["Expand"]) @notebook.Name" title="@(expanded ? T["Collapse"] : T["Expand"])" tabindex="-1"
                                    @onclick="() => Toggle(notebook.Id)">@(expanded ? "−" : "+")</button>
                        }
                        else
                        {
                            <span class="wn-twisty" aria-hidden="true"></span>
                        }
                        @if (_renamingId == notebook.Id)
                        {
                            <InlineRename Value="@notebook.Name" MaxLength="200" OnCommit="name => CommitRenameAsync(notebook.Id, name)" OnCancel="() => _renamingId = null" />
                        }
                        else
                        {
                            <button type="button" class="wn-navitem @SelectedClass(selection) @DropClass(notebook.Id)" aria-current="@Current(selection)" title="@notebook.Name"
                                    data-tree-item data-drop-row data-level="0" data-expanded="@(hasChildren ? (expanded ? "true" : "false") : null)"
                                    @onclick="() => OnSelect.InvokeAsync(selection)" @ondblclick="() => _renamingId = notebook.Id"
                                    @onkeydown="e => OnNotebookKeyAsync(e, notebook.Id)"
                                    @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((selection, e))"
                                    draggable="true" @ondragstart="() => OnNotebookDragStart.InvokeAsync(notebook.Id)" @ondragend="OnDragEnd"
                                    @ondragenter="() => _dropTarget = notebook.Id" @ondragover:preventDefault @ondrop:preventDefault @ondrop="() => DropAsync(selection)">@notebook.Name</button>
                        }
                        <button type="button" class="wn-row-add" title="@T["Add a note or folder in {0}", notebook.Name]" aria-label="@T["Add a note or folder in {0}", notebook.Name]" tabindex="-1"
                                @onclick="e => OnAddFolder.InvokeAsync((notebook.Id, null, e))">+</button>
                    </div>
                    @if (hasChildren && expanded)
                    {
                        <FolderTree NotebookId="notebook.Id" ParentId="null" Children="_children" Notes="_notes" Expanded="_expandedFolders" DropTarget="_dropTarget"
                                    Selection="Selection" CurrentNoteId="CurrentNoteId" OnSelect="OnSelect" OnToggle="Toggle" OnContextMenu="OnContextMenu"
                                    OnDragStart="OnDragStart" OnDragEnd="OnDragEnd" OnDragEnter="id => _dropTarget = id" OnDrop="DropAsync" OnAddFolder="OnAddFolder"
                                    OnRenameFolder="OnRenameFolder" OnDeleteFolder="OnDeleteFolder" OnAddUnderNote="OnAddUnderNote"
                                    OnOpenNote="OnOpenNote" OnNoteContextMenu="OnNoteContextMenu" OnNoteDragStart="OnNoteDragStart"
                                    OnRenameNote="OnRenameNote" OnDeleteNote="OnDeleteNote" SharedOrder="SharedOrder" OnDropOnNote="OnDropOnNote" OnMoveBy="OnMoveBy" Level="1" />
                    }
                </li>
            }
        </ul>
    }

    <div class="wn-nav-section">
        <h2 id="wn-calendar-heading">@T["Calendar"]</h2>
    </div>
    <ul class="wn-nav-list" aria-labelledby="wn-calendar-heading">
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Calendar())" aria-current="@Current(new NavSelection.Calendar())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Calendar())">@T["Month view"]</button>
        </li>
        @if (CalendarNotebook is { } calendar)
        {
            var allEntries = new NavSelection.Notebook(calendar.Id);
            <li>
                <button type="button" class="wn-navitem @SelectedClass(allEntries)" aria-current="@Current(allEntries)"
                        title="@T["Every calendar note as a list"]" @onclick="() => OnSelect.InvokeAsync(allEntries)">@T["All calendar notes"]</button>
            </li>
        }
    </ul>

    @if (Tags.Count > 0)
    {
        <div class="wn-nav-section">
            <h2 id="wn-tags-heading">@T["Tags"]</h2>
        </div>
        <ul class="wn-nav-list" aria-labelledby="wn-tags-heading">
            @foreach (var tag in Tags)
            {
                var selection = new NavSelection.Tag(tag.Id);
                <li @key="tag.Id">
                    <button type="button" class="wn-navitem wn-navitem-tag @SelectedClass(selection)" aria-current="@Current(selection)"
                            @onclick="() => OnSelect.InvokeAsync(selection)"
                            @oncontextmenu:preventDefault @oncontextmenu="e => OnContextMenu.InvokeAsync((selection, e))">
                        <span class="wn-navitem-label">@tag.Name</span>
                        <span class="wn-navitem-count">@tag.NoteCount</span>
                    </button>
                </li>
            }
        </ul>
    }

    <ul class="wn-nav-list wn-nav-bottom">
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Trash())" aria-current="@Current(new NavSelection.Trash())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Trash())">@T["Trash"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Data())" aria-current="@Current(new NavSelection.Data())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Data())">@T["Import & backup"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Settings())" aria-current="@Current(new NavSelection.Settings())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Settings())">@T["Settings"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.Documentation())" aria-current="@Current(new NavSelection.Documentation())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.Documentation())">@T["Documentation"]</button>
        </li>
        <li>
            <button type="button" class="wn-navitem @SelectedClass(new NavSelection.About())" aria-current="@Current(new NavSelection.About())"
                    @onclick="() => OnSelect.InvokeAsync(new NavSelection.About())">@T["About"]</button>
        </li>
    </ul>
</nav>

@code {
    private HashSet<Guid> _collapsedNotebooks = [];
    private HashSet<Guid> _expandedFolders = [];
    private bool _treeStateLoaded;
    private NavSelection? _revealedSelection;
    private ILookup<(Guid NotebookId, Guid? ParentId), FolderSummary> _children = Array.Empty<FolderSummary>().ToLookup(f => (f.NotebookId, f.ParentId));
    private ILookup<(Guid NotebookId, Guid? ParentId), NoteSummary> _notes = Array.Empty<NoteSummary>().ToLookup(n => (n.NotebookId, n.ParentId));
    private Guid? _dropTarget;
    private Guid? _renamingId;

    /// <summary>The element, for the host to attach keyboard handling to.</summary>
    public ElementReference Root { get; private set; }

    [Parameter, EditorRequired] public IReadOnlyList<NotebookSummary> Notebooks { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<FolderSummary> Folders { get; set; } = [];
    [Parameter] public IReadOnlyList<TagSummary> Tags { get; set; } = [];
    [Parameter] public IReadOnlyList<WorriorVex.Application.Settings.SavedSearch> SavedSearches { get; set; } = [];
    [Parameter] public IReadOnlyList<Guid> ExpandedFolders { get; set; } = [];
    [Parameter] public IReadOnlyList<Guid> CollapsedNotebooks { get; set; } = [];

    /// <summary>A branch was opened or closed; the owner remembers the state.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<Guid> ExpandedFolders, IReadOnlyList<Guid> CollapsedNotebooks)> OnTreeStateChanged { get; set; }

    /// <summary>Notes to show as leaves of the tree; empty when the tree shows folders only.</summary>
    [Parameter] public IReadOnlyList<NoteSummary> TreeNotes { get; set; } = [];

    [Parameter] public Guid? CurrentNoteId { get; set; }
    [Parameter] public EventCallback<(Guid NotebookId, string Name)> OnRenameNotebook { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteNotebook { get; set; }
    [Parameter] public EventCallback<(Guid FolderId, string Name)> OnRenameFolder { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteFolder { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenNote { get; set; }
    [Parameter] public EventCallback<(NoteSummary Note, MouseEventArgs Mouse)> OnNoteContextMenu { get; set; }
    [Parameter] public EventCallback<Guid> OnNoteDragStart { get; set; }
    [Parameter] public EventCallback<(Guid NoteId, string Title)> OnRenameNote { get; set; }
    [Parameter] public EventCallback<Guid> OnDeleteNote { get; set; }
    [Parameter, EditorRequired] public NavSelection Selection { get; set; } = new NavSelection.AllNotes();

    /// <summary>Something is being dragged; notebooks and folders light up as it passes over them.</summary>
    [Parameter] public bool Dragging { get; set; }

    [Parameter] public EventCallback<NavSelection> OnSelect { get; set; }
    [Parameter] public EventCallback OnNewNotebook { get; set; }
    [Parameter] public EventCallback<(NavSelection Target, MouseEventArgs Mouse)> OnContextMenu { get; set; }

    /// <summary>The + on a notebook or folder row: a new folder inside it.</summary>
    [Parameter] public EventCallback<(Guid NotebookId, Guid? ParentId, MouseEventArgs Mouse)> OnAddFolder { get; set; }
    [Parameter] public EventCallback<(NoteSummary Note, MouseEventArgs Mouse)> OnAddUnderNote { get; set; }
    [Parameter] public bool SharedOrder { get; set; }
    [Parameter] public EventCallback<Guid> OnDropOnNote { get; set; }
    [Parameter] public EventCallback<(Guid Id, int Step)> OnMoveBy { get; set; }

    /// <summary>A folder in the tree started being dragged.</summary>
    [Parameter] public EventCallback<Guid> OnDragStart { get; set; }

    /// <summary>A whole notebook started being dragged, to be put inside another notebook or folder.</summary>
    [Parameter] public EventCallback<Guid> OnNotebookDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    /// <summary>Something was dropped on a notebook or folder.</summary>
    [Parameter] public EventCallback<NavSelection> OnDrop { get; set; }

    private NotebookSummary? Inbox => Notebooks.FirstOrDefault(n => n.IsInbox);
    private List<NotebookSummary> UserNotebooks => [.. Notebooks.Where(n => !n.IsInbox && !n.IsCalendar)];
    private NotebookSummary? CalendarNotebook => Notebooks.FirstOrDefault(n => n.IsCalendar);

    protected override void OnParametersSet()
    {
        _children = Folders.ToLookup(f => (f.NotebookId, f.ParentId));
        _notes = TreeNotes.ToLookup(n => (n.NotebookId, n.ParentId));
        if (!Dragging)
        {
            _dropTarget = null;
        }

        if (!_treeStateLoaded)
        {
            // What was open last time; after that the sets are kept here and written back when they change.
            _treeStateLoaded = true;
            _expandedFolders = [.. ExpandedFolders];
            _collapsedNotebooks = [.. CollapsedNotebooks];
        }

        // When the selection moves to a folder it must be visible: open every branch above it, and the
        // folder itself. Only on a change, so a person can still fold a branch away while it is selected.
        if (Selection is NavSelection.Folder selected && !Equals(Selection, _revealedSelection))
        {
            _revealedSelection = Selection;
            _collapsedNotebooks.Remove(selected.NotebookId);
            var byId = Folders.ToDictionary(f => f.Id);
            var at = (Guid?)selected.FolderId;
            while (at is { } id && byId.TryGetValue(id, out var folder))
            {
                _expandedFolders.Add(id);
                at = folder.ParentId;
            }
        }
    }

    private async Task Toggle(Guid id)
    {
        if (Notebooks.Any(n => n.Id == id) || Inbox?.Id == id)
        {
            if (!_collapsedNotebooks.Remove(id))
            {
                _collapsedNotebooks.Add(id);
            }
        }
        else if (!_expandedFolders.Remove(id))
        {
            _expandedFolders.Add(id);
        }

        await OnTreeStateChanged.InvokeAsync(([.. _expandedFolders], [.. _collapsedNotebooks]));
    }

    private async Task CommitRenameAsync(Guid notebookId, string name)
    {
        _renamingId = null;
        await OnRenameNotebook.InvokeAsync((notebookId, name));
    }

    private async Task OnNotebookKeyAsync(KeyboardEventArgs args, Guid notebookId)
    {
        if (notebookId == Inbox?.Id)
        {
            return;
        }

        switch (args.Key)
        {
            case "F2":
                _renamingId = notebookId;
                break;
            case "Delete":
                await OnDeleteNotebook.InvokeAsync(notebookId);
                break;
        }
    }

    private async Task DropAsync(NavSelection target)
    {
        _dropTarget = null;
        await OnDrop.InvokeAsync(target);
    }

    private string? SelectedClass(NavSelection selection) => selection == Selection ? "is-selected" : null;
    private string? Current(NavSelection selection) => selection == Selection ? "true" : null;
    private string? DropClass(Guid id) => Dragging && _dropTarget == id ? "is-droptarget" : null;
}
