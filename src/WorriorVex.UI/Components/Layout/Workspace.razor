@implements IAsyncDisposable

<div @key="T.Language" class="wn-app @(_sidebarHidden ? "is-nav-hidden" : null) @(_focusMode && !IsHelpPage ? "is-focus" : null) @(Settings.Current.ListDensity == ListDensity.Compact ? "is-compact" : null)">
    <header class="wn-topbar">
        <button type="button" class="wn-iconbutton" title="@T["Show or hide the sidebar"] (@_modifier+\)" aria-label="@T["Show or hide the sidebar"]" aria-pressed="@(_sidebarHidden ? "true" : "false")" @onclick="() => _sidebarHidden = !_sidebarHidden">☰</button>
        <img class="wn-brand-mark" src="_content/WorriorVex.UI/img/worriorvex.svg" alt="" width="20" height="20" />
        <span class="wn-brand">WorriorVex</span>
        <SearchBox @ref="_searchBox" Text="@_searchText" OnChanged="SearchAsync" OnMove="MoveSearchMark" OnOpen="OpenMarkedResultAsync" OnClose="CloseSearchAsync" />
        <button type="button" class="wn-button wn-button-primary" @onclick="NewNoteAsync" title="@T["New note"] (@_modifier+N)">+ @T["New"]</button>
        <button type="button" class="wn-button" @onclick="() => _templatePicker = true" title="@T["New note from a template"] (@_modifier+Shift+N)" aria-label="@T["New note from a template"]">▾</button>
        @if (_update is { } available)
        {
            @* Stays in the top bar until the app is updated, whatever else the banner is saying. *@
            <button type="button" class="wn-button wn-update-badge" title="@T["WorriorVex {0} is available (you have {1}).", available.LatestVersion, available.CurrentVersion]"
                    @onclick="() => Shell.OpenWebPage(available.DownloadPage)">⬆ @T["Version {0} available", available.LatestVersion]</button>
        }
        <button type="button" class="wn-iconbutton @(_focusMode ? "is-active" : null)" title="@T["Focus mode: only the note"] (@_modifier+Shift+F)" aria-label="@T["Focus mode"]" aria-pressed="@(_focusMode ? "true" : "false")" @onclick="() => _focusMode = !_focusMode">⤢</button>
    </header>

    <NavPane @ref="_navPane" Notebooks="_notebooks" Folders="_folders" Tags="_tags" SavedSearches="Settings.Current.SavedSearches" Selection="_selection" Dragging="@(_dragging is not null || _draggingNotebook is not null)"
             TreeNotes="_treeNotes" CurrentNoteId="@(IsHelpPage ? null : _current?.Id)"
             ExpandedFolders="Settings.Current.ExpandedFolders" CollapsedNotebooks="Settings.Current.CollapsedNotebooks" OnTreeStateChanged="SaveTreeStateAsync"
             OnSelect="SelectAsync" OnNewNotebook="PromptNewNotebook" OnContextMenu="ShowNavMenu" OnAddFolder="AddBranch"
             OnRenameNotebook="RenameNotebookAsync" OnDeleteNotebook="id => ConfirmDeleteNotebook(id, NotebookName(id))"
             OnRenameFolder="RenameFolderAsync" OnDeleteFolder="id => ConfirmDeleteFolder(id, FolderName(id))"
             OnOpenNote="OpenFromTreeAsync" OnNoteContextMenu="ShowNoteMenu" OnNoteDragStart="id => _dragging = (id, false)"
             OnRenameNote="RenameNoteAsync" OnDeleteNote="DeleteNoteAsync" OnAddUnderNote="AddUnderNote"
             SharedOrder="@SharedOrder" OnDropOnNote="DropOnNoteAsync" OnMoveBy="MoveItemByAsync"
             OnDragStart="id => _dragging = (id, true)" OnNotebookDragStart="id => _draggingNotebook = id"
             OnDragEnd="() => { _dragging = null; _draggingNotebook = null; }" OnDrop="DropAsync" />

    <button type="button" class="wn-resizer" @ref="_navResizer" role="separator" aria-orientation="vertical" aria-label="@T["Width of the navigation pane"]"
            aria-valuemin="@AppSettings.MinPaneWidth" aria-valuemax="@AppSettings.MaxPaneWidth" aria-valuenow="@Settings.Current.NavigationWidth"
            title="@T["Drag to resize; arrow keys when focused"]" style="grid-area: nav; justify-self: end; position: relative; height: 100%;"
            @onkeydown="e => ResizeByKeyAsync(e, NavWidthVariable)"></button>

    @if (IsHelpPage)
    {
        @* Help pages use the width of the list and editor panes together. *@
    }
    else if (_selection is NavSelection.Search)
    {
        <SearchResults Query="@_searchText" Results="_searchResults" Searching="_searching" SelectedId="_current?.Id"
                       MarkedIndex="_searchMark" OnSelect="OpenAsync" ScopeName="@SearchScopeName" Scoped="_searchScoped" OnScopedChanged="SetSearchScopeAsync"
                       OnSave="PromptSaveSearch" Suggestion="@_suggestion" OnSuggestion="UseSuggestionAsync" />
    }
    else if (_selection is NavSelection.Trash)
    {
        <TrashList Items="_trash" SelectedId="_trashItem?.Id" OnSelect="item => _trashItem = item" OnEmpty="ConfirmEmptyTrash" />
    }
    else
    {
        <NoteList Heading="@Heading" Notes="_notes" SelectedId="_current?.Id" NotebookNames="@(ShowsManyPlaces ? NotebookNames : null)"
                  FirstEver="@(_selection is NavSelection.AllNotes)" EmptyMessage="@EmptyMessage" ShowOpened="@(_selection is NavSelection.Recent)"
                  ShowActions="true" OnSelect="OpenAsync" OnCreate="NewNoteAsync" OnContextMenu="ShowNoteMenu" OnRename="RenameNoteAsync" OnDelete="DeleteNoteAsync"
                  OnDragStart="id => _dragging = (id, false)" OnDragEnd="() => _dragging = null">
            @if (CanHoldFolders)
            {
                <button type="button" class="wn-button wn-button-small" @onclick="PromptNewFolder">@T["New folder"]</button>
            }
            @if (CanChangeContainer)
            {
                @* These act on the place itself (the folder or notebook), never on a note: the words say so. *@
                <button type="button" class="wn-button wn-button-small" title="@(_selection is NavSelection.Folder ? T["Rename this folder"] : T["Rename this notebook"])" @onclick="PromptRename">@(_selection is NavSelection.Folder ? T["Rename folder…"] : T["Rename notebook…"])</button>
                <button type="button" class="wn-button wn-button-small wn-button-quiet-danger" title="@(_selection is NavSelection.Folder ? T["Move this folder and everything in it to the trash"] : T["Move this notebook and everything in it to the trash"])" @onclick="ConfirmDeleteContainer">@(_selection is NavSelection.Folder ? T["Delete folder…"] : T["Delete notebook…"])</button>
            }
            <select class="wn-select wn-list-sort" aria-label="@T["Sort notes"]" title="@T["Sort notes"]" value="@Settings.Current.NoteSort" @onchange="e => SetSortAsync(Enum.Parse<NoteSort>((string)e.Value!))">
                <option value="@NoteSort.Added">@T["Your order (new at the bottom)"]</option>
                <option value="@NoteSort.Updated">@T["Last changed"]</option>
                <option value="@NoteSort.Created">@T["Newest"]</option>
                <option value="@NoteSort.Title">@T["Title"]</option>
            </select>
        </NoteList>
    }

    @if (!IsHelpPage)
    {
        <button type="button" class="wn-resizer" @ref="_listResizer" role="separator" aria-orientation="vertical" aria-label="@T["Width of the note list"]"
                aria-valuemin="@AppSettings.MinPaneWidth" aria-valuemax="@AppSettings.MaxPaneWidth" aria-valuenow="@Settings.Current.ListWidth"
                title="@T["Drag to resize; arrow keys when focused"]" style="grid-area: list; justify-self: end; position: relative; height: 100%;"
                @onkeydown="e => ResizeByKeyAsync(e, ListWidthVariable)"></button>
    }

    <main class="wn-main @(IsHelpPage ? "wn-main-wide" : null)">
        @if (_error is not null)
        {
            <div class="wn-banner" role="alert">
                <span>@_error</span>
                <button type="button" class="wn-button" @onclick="() => _error = null">@T["Dismiss"]</button>
            </div>
        }
        else if (_notice is not null)
        {
            <div class="wn-banner wn-banner-info" role="status">
                <span>@_notice</span>
                <button type="button" class="wn-button" @onclick="() => _notice = null">@T["Dismiss"]</button>
            </div>
        }
        else if (_update is { } update)
        {
            <div class="wn-banner wn-banner-info" role="status">
                <span>@T["WorriorVex {0} is available (you have {1}).", update.LatestVersion, update.CurrentVersion]</span>
                <span>
                    <button type="button" class="wn-button" @onclick="() => Shell.OpenWebPage(update.DownloadPage)">@T["Open the downloads page"]</button>
                    <button type="button" class="wn-button" @onclick="() => _update = null">@T["Later"]</button>
                </span>
            </div>
        }

        @if (_loading)
        {
            <div class="wn-empty"><p>@T["Loading…"]</p></div>
        }
        else if (_selection is NavSelection.Documentation)
        {
            <DocumentationPage />
        }
        else if (_selection is NavSelection.Data)
        {
            <DataPage OnImported="AfterImportAsync" OnRestored="AfterRestoreAsync" BeforeRestore="SaveBeforeLeavingAsync" PackageToImport="@_pendingPackage" />
        }
        else if (_selection is NavSelection.Settings)
        {
            <SettingsPage />
        }
        else if (_selection is NavSelection.Calendar)
        {
            <CalendarPage OnOpenNote="OpenLinkedNoteAsync" OnChanged="LoadStructureAsync" />
        }
        else if (_selection is NavSelection.About)
        {
            <AboutPage />
        }
        else if (_selection is NavSelection.Trash)
        {
            @if (_trashItem is null)
            {
                <div class="wn-empty"><p>@(_trash.Count == 0 ? T["Deleted notes, folders and notebooks wait here until you restore or remove them."] : T["Select an item to restore it or delete it permanently."])</p></div>
            }
            else
            {
                <TrashDetail Item="_trashItem" OnRestore="RestoreAsync" OnDelete="ConfirmDeletePermanently" />
            }
        }
        else if (_current is null && _selection is NavSelection.Search)
        {
            <div class="wn-empty"><p>@(_searchResults.Count == 0 ? T["Search looks through the titles, text and tags of all your notes."] : T["Select a note to open it, or press Enter for the first one."])</p></div>
        }
        else if (_current is null && _firstRun)
        {
            <WelcomePanel OnCreateNotebook="PromptNewNotebook" OnNewNote="NewNoteAsync" OnImport="() => SelectAsync(new NavSelection.Data())" />
        }
        else if (_current is null)
        {
            <div class="wn-empty">
                <p>@T["No note selected."]</p>
                <button type="button" class="wn-button wn-button-primary" @onclick="NewNoteAsync">@T["New note"]</button>
            </div>
        }
        else
        {
            <NoteEditor @ref="_editor" Note="_current" OnEdited="OnEdited" OnDelete="DeleteCurrentNoteAsync" OnProblem="@(message => _error = message)"
                        OnToggleFavorite="ToggleFavoriteAsync" OnTogglePinned="TogglePinnedAsync" OnTagsChanged="OnTagsChangedAsync"
                        OnOpenNote="OpenLinkedNoteAsync" ConnectionsVersion="_connectionsVersion" OnRestored="OnRestoredAsync" />
        }
    </main>

    <footer class="wn-statusbar">
        <SaveStatus State="Autosaver.State" OnRetry="SaveNowAsync" Detail="@StatusDetail" />
    </footer>

    @if (_prompt is not null)
    {
        <PromptDialog @key="_prompt" Title="@_prompt.Title" Label="@_prompt.Label" InitialValue="@_prompt.InitialValue" ConfirmText="@_prompt.ConfirmText"
                      MaxLength="_prompt.MaxLength" Error="@_dialogError" OnConfirm="ConfirmPromptAsync" OnCancel="CloseDialogs" />
    }

    @if (_move is not null)
    {
        <MoveDialog @key="_move" Title="@T["Move “{0}”", _move.Name]" Notebooks="_notebooks" Folders="_folders" Excluded="_move.Excluded"
                    Error="@_dialogError" OnConfirm="ConfirmMoveAsync" OnCancel="CloseDialogs" />
    }

    @if (_templatePicker)
    {
        <TemplatePickerDialog OnPick="NewFromTemplateAsync" OnCancel="() => _templatePicker = false" />
    }

    @if (_export is { } export)
    {
        <ExportNoteDialog @key="export" Title="@export.Title" OnConfirm="format => ExportNoteAsync(export, format)" OnCancel="CloseDialogs" />
    }

    @if (_menu is not null)
    {
        <ContextMenu Items="_menu.Items" X="_menu.X" Y="_menu.Y" Label="@_menu.Label" OnClose="() => _menu = null" />
    }

    @if (_confirm is not null)
    {
        <ConfirmDialog @key="_confirm" Title="@_confirm.Title" Message="@_confirm.Message" ConfirmText="@_confirm.ConfirmText" Danger="_confirm.Danger"
                       OnConfirm="ConfirmActionAsync" OnCancel="CloseDialogs" />
    }
</div>
